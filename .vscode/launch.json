{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.1.90",
    "configurations": [
        {
            "name": "Debug scrape integration tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/scrape",
            "buildFlags": "-tags=integration",
            "env": {
                "TEST_DATABASE_URL": "postgresql://dsr_usr:dsrpwd@localhost:5436/dsr_db_test?sslmode=disable"
            }
        },
        {
            "name": "Debug current test file",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "buildFlags": "-tags=integration",
            "env": {
                "TEST_DATABASE_URL": "postgresql://dsr_usr:dsrpwd@localhost:5436/dsr_db_test?sslmode=disable"
            }
        }
    ]
}